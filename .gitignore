# Python
__pycache__/
*.pyc
.pytest_cache/
backend/.venv/
venv/

# Node
node_modules/

# Build artifacts (regenerable via scripts/build.js)
dist/
# Exclude ONLY PyInstaller's transient intermediate output directory. Do NOT exclude
# the whole "build/" dir: that would make it impossible to commit build/nsis-clean.nsh
# (a source-of-truth NSIS include electron-builder's "nsis.include" config requires),
# since git cannot re-include a file inside an already-excluded directory.
build/amt-backend/
release/

# Ready-made distributable installer (too large for Git; distribute via GitHub
# Releases instead of committing to the repo)
AMT Chat Setup.exe

# Runtime data (per-user; in frozen desktop mode these live under %APPDATA%\AMT Chat\)
backend/logs/
backend/chats/
backend/files/
backend/projects_current.json
backend/ai_engine/memory.json
backend/sysinteraction.json
backend/tools_config.json
backend/tools_log.jsonl
backend/desktop_log.jsonl
extensions_state.json

# Local secrets — never commit real API keys. Keep keys.json structure with an
# empty apiKey placeholder only.
# (Do NOT add an exception that re-includes a populated keys.json.)

# OS
Thumbs.db
.DS_Store
