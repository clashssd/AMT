{
  "name": "amt-chat",
  "productName": "AMT Chat",
  "version": "1.1.2",
  "description": "Local AI assistant with desktop shell and extension system",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test:py": "pytest tests/",
    "test:js": "node tests/run_js_tests.js",
    "test": "pytest tests/ && node tests/run_js_tests.js",
    "build:py": "python -m PyInstaller backend/amt-backend.spec --noconfirm",
    "sync-frontend": "node -e \"const fs=require('fs'),p=require('path'),s=p.resolve('frontend'),d=p.resolve('dist/amt-backend/_internal/frontend');fs.mkdirSync(d,{recursive:true});fs.rmSync(d,{recursive:true,force:true});fs.cpSync(s,d,{recursive:true});console.log('frontend → dist/amt-backend/_internal/frontend')\"",
    "build": "electron-builder",
    "build:win": "npm run sync-frontend && electron-builder --win",
    "build:all": "node scripts/build.js all"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.amt.chat",
    "productName": "AMT Chat",
    "publish": {
      "provider": "github",
      "owner": "clashssd",
      "repo": "AMT"
    },
    "win": {
      "target": "nsis",
      "icon": "frontend/assets/icon-256.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/nsis-clean.nsh"
    },
    "files": [
      "main.js",
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "dist/amt-backend",
        "to": "amt-backend",
        "filter": ["**/*"]
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
